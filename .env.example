# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# DB_PROVIDER controls which Prisma datasource provider prisma/schema.prisma uses.
# Change it with `npm run db:use sqlite` or `npm run db:use postgresql`
# (the script rewrites the provider line in the schema, which Prisma requires
# to be a literal — it cannot be read from an env var at runtime).

# Local development (default):
DATABASE_URL="file:./dev.db"

# Production (Postgres — Neon / Supabase / RDS / 阿里云 RDS / 腾讯云 TencentDB):
# DATABASE_URL="postgresql://user:password@host:5432/travelingmate?schema=public&sslmode=require"

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# Sign the session JWT. Generate one with:  openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
# Public origin, used for absolute links. No trailing slash.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Email address that gets the ADMIN role on seed.
ADMIN_EMAIL="admin@travelingmate.test"
ADMIN_PASSWORD="guanliyuan123"
